# =============================================================================
# IoE Smart Shopping Cart — Git Ignore Configuration
# =============================================================================

# --- Environment & Secret Credentials (CRITICAL: NEVER COMMIT SECRETS) ---
.env
.env.local
.env.*.local
*.env
*.env.production
*.env.development
*.pem
*.key
*.cert
*.crt
*credentials*.json
*firebase-adminsdk*.json
serviceAccountKey.json
google-services.json
GoogleService-Info.plist

# Preserve template files
!/.env.example
!/**/.env.example

# --- Dependencies ---
node_modules/
**/node_modules/
package-lock.json.bak
yarn.lock.bak

# --- Build Outputs ---
dist/
**/dist/
build/
**/build/
out/
.vite/
*.tsbuildinfo

# --- Firebase Cache & Emulators ---
.firebase/
firebase-debug.log*
firestore-debug.log*
ui-debug.log*
database-debug.log*
hosting.*.cache

# --- Firmware & Arduino Build Artifacts ---
*.hex
*.elf
*.bin
*.o
*.a
*.srec
firmware/build/
sketch/

# --- Logs ---
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Thumbs.db:encryptable
desktop.ini
$RECYCLE.BIN/

# --- IDE & Editor Settings ---
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-workspace
*.sublime-project
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# --- Python & Virtual Environments (if applicable) ---
__pycache__/
*.py[cod]
*$py.class
venv/
env/
.venv/
.env/
